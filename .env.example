# Nebius Token Factory — get from https://console.nebius.com/token-factory
NEBIUS_API_KEY=

# Optional durable shared budget for Render Free chat (disabled unless selected).
# Initialize the ledger once before enabling chat; see docs/free-chat.md.
# CHRONICLE_SPEND_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# CHRONICLE_SPEND_BUDGET_ID=demo-v1
# CHRONICLE_SPEND_LIMIT_USD=0.25
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model selection: use Lightning for dev, Ultra for official benchmark runs
# CHRONICLE_MODEL=nvidia/Nemotron-3_5-Lightning   # or nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily — get from https://tavily.com (Builders Program gives free credits)
TAVILY_API_KEY=

# Hermes plugin: set to 0 to stop masking emails/phones/IDs in recalled memory
# CHRONICLE_REDACT_RECALL=1

# Benchmark runs only: set to off to send names/organisations/places unmasked
# (emails/phones/IDs stay masked). Report scores both ways. Leave unset otherwise.
# CHRONICLE_REDACT_NAMES=
